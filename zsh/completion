autoload -Uz compinit && compinit

# matches case insensitive for lowercase
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# pasting with tabs doesn't perform completion
zstyle ':completion:*' insert-tab pending

[[ -f /usr/local/share/zsh/site-functions ]] && . /usr/local/share/zsh/site-functions

# setup kubectl autocomplete
[[ $commands[kubectl] ]] && source <(kubectl completion zsh)
compdef __start_kubectl k

# Completions are not shared between bash and ZSH and so are not loaded by bourne.sh
# For ZSH the completions are loaded by the asdf plugin for zsh
